# Copie para .env e preencha. O .env NUNCA vai para o git.

# ---------------------------------------------------------------- ambiente
# sandbox | prod
EXTRATO_ENV=sandbox

# ------------------------------------------------------- credenciais (Extrato)
EXTRATO_CLIENT_ID=
EXTRATO_CLIENT_SECRET=

# ------------------------------------------------------------- certificados
# Caminhos relativos a raiz do projeto ou absolutos.
EXTRATO_CERT_PATH=certs/certificado.crt
EXTRATO_KEY_PATH=certs/chave.key

# ------------------------------------------------------------------- API
# Os hosts sao derivados de EXTRATO_ENV (sandbox/prod). Descomente so para sobrescrever.
# EXTRATO_TOKEN_URL=
# EXTRATO_API_BASE_URL=
EXTRATO_HTTP_TIMEOUT=30

# ------------------------------------------------------------------- conta
# Agencia e conta vao SEM o digito na chamada da API.
EXTRATO_AGENCIA=
EXTRATO_CONTA=
EXTRATO_CONTA_DIGITO=
# cc = conta corrente | cp = poupanca
EXTRATO_TIPO_CONTA=cc
# 1 = saldo do dia (so conta corrente) | 2 = unificado com Invest Facil
EXTRATO_TIPO_OPERACAO=1

# ------------------------------------------------------------------ e-mail
EXTRATO_SMTP_HOST=smtp.gmail.com
EXTRATO_SMTP_PORT=587
EXTRATO_SMTP_USER=
# Gmail: use uma "senha de app", nao a senha da conta.
EXTRATO_SMTP_PASSWORD=
EXTRATO_SMTP_FROM=
# Separados por virgula.
EXTRATO_DESTINATARIOS=

# ----------------------------------------------------------------- operacao
EXTRATO_RETENCAO_PDF_DIAS=90
EXTRATO_LOG_LEVEL=INFO
