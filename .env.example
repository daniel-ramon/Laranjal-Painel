# ===== Painel Contas a Pagar =====
# Copie para ".env" e preencha.

PORT=3300

# true = dados de exemplo | false = conecta no Oracle
USE_MOCK=true

# Pasta do Oracle Instant Client 64-bit (descompactado). Ex.: C:\oracle\instantclient_19_26
ORACLE_CLIENT_LIB_DIR=

# Pasta do tnsnames.ora (reaproveita os aliases AK/ORCL que o SQL Navigator já usa)
ORACLE_TNS_ADMIN=D:\oracle\product\10.2.0\db_1\network\admin

# ---- Base AK (AKHORTIFRUTI) ----  conecta pelo alias TNS "AK"
AK_USER=
AK_PASSWORD=
AK_CONNECT=AK

# ---- Base JRF (LARANJAL) ----  conecta pelo alias TNS "ORCL"
JRF_USER=
JRF_PASSWORD=
JRF_CONNECT=ORCL
